    family-names: Nelli
    email: meccanismo.complesso@gmail.com
version: 0.2.0
date-released: "2026-11-08"
license: MIT
repository-code: "https://github.com/meccanismocomplesso/acc"
keywords:
  - anticlustering
  - experimental design
  - adaptive sampling
  - heterogeneous treatment effects
  - adaptive enrichment
